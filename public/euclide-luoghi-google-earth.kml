<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>ITI Euclide — punti di riferimento</name>
    <description>Riferimenti geografici per il progetto di orientamento. Due punti, non un percorso stradale né una ricostruzione dell'edificio.</description>
    <Style id="partenza"><IconStyle><color>ff99bd79</color><scale>1.3</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon></IconStyle></Style>
    <Style id="scuola"><IconStyle><color>ff4b8ad9</color><scale>1.3</scale><Icon><href>http://maps.google.com/mapfiles/kml/paddle/ylw-circle.png</href></Icon></IconStyle></Style>
    <Placemark>
      <name>Partenza — SP178</name>
      <description><![CDATA[Punto del link condiviso: https://maps.app.goo.gl/pVL9dVwe4yynCdC79 . La vista stradale mostra la SP178; la sequenza fra questo punto e la scuola va verificata sulla mappa stradale.]]></description>
      <styleUrl>#partenza</styleUrl>
      <LookAt><longitude>14.504148</longitude><latitude>37.205545</latitude><range>350</range><tilt>55</tilt><heading>35</heading></LookAt>
      <Point><coordinates>14.504148,37.205545,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Arrivo — Istituto Tecnico Industriale Euclide</name>
      <description><![CDATA[Via Mario Scelba 1, Caltagirone. Coordinate tratte dal link Google Maps della scheda ufficiale del luogo: https://www.iiscucuzzaeuclide.edu.it/luogo/istituto-tecnico-industriale/ . La posizione non rappresenta la porta esatta né la pianta dell'edificio.]]></description>
      <styleUrl>#scuola</styleUrl>
      <LookAt><longitude>14.512260526212497</longitude><latitude>37.21133775</latitude><range>350</range><tilt>55</tilt><heading>35</heading></LookAt>
      <Point><coordinates>14.512260526212497,37.21133775,0</coordinates></Point>
    </Placemark>
  </Document>
</kml>
